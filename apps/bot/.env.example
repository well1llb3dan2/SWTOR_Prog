# Discord bot token from the Developer Portal (Bot → Reset Token).
DISCORD_TOKEN=

# Channel the bot posts progression announcements into.
PROGRESSION_CHANNEL_ID=

# Channel signup posts go to. Defaults to PROGRESSION_CHANNEL_ID.
# SIGNUP_CHANNEL_ID=

# How often the bot checks for newly scheduled operations to post.
CALENDAR_POLL_MS=60000

# Must match the API's FEED_TOKEN (which defaults to its INGEST_TOKEN).
FEED_TOKEN=change-me-to-a-long-random-string

API_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# Wipes are only announced when the boss ends below this health and the
# attempt beats the guild's previous best.
CLOSE_WIPE_PERCENT=15

# Set to false to also announce trash and unmatched pulls.
BOSSES_ONLY=true
