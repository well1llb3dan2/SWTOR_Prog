{
  "name": "@swtor/desktop",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "SWTOR Combat Streamer desktop client",
  "author": "Infamous",
  "repository": {
    "type": "git",
    "url": "https://github.com/well1llb3dan2/SWTOR_Prog.git"
  },
  "main": "dist/main.cjs",
  "scripts": {
    "build:main": "esbuild src/main.ts --bundle --platform=node --format=cjs --target=node20 --external:electron --outfile=dist/main.cjs",
    "build:preload": "esbuild src/preload.ts --bundle --platform=node --format=cjs --target=node20 --external:electron --outfile=dist/preload.cjs",
    "build:renderer": "esbuild src/renderer/index.html src/renderer/app.js --outdir=dist/renderer --loader:.html=copy --loader:.js=copy",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "package": "npm run build && electron-builder --config electron-builder.yml --publish never",
    "release": "npm run build && electron-builder --config electron-builder.yml --publish always",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@swtor/analytics": "workspace:*",
    "@swtor/parser": "workspace:*",
    "@swtor/shared": "workspace:*",
    "electron-updater": "^6.3.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2"
  }
}
