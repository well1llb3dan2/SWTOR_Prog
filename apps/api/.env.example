# Required. Shared secret the desktop client presents on the ingest namespace.
INGEST_TOKEN=change-me-to-a-long-random-string

# Secret for service consumers of the /feed namespace, such as the Discord bot.
# Defaults to INGEST_TOKEN when unset; set it separately in production so a
# leaked bot credential cannot be used to inject combat data.
# FEED_TOKEN=change-me-to-a-different-long-random-string

PORT=3001
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# Omit MONGODB_URI to run fully in memory; reports are then lost on restart.
# MONGODB_URI=mongodb+srv://user:password@cluster/
MONGODB_DB=swtor

# Days to keep raw combat events. Omit to keep them indefinitely.
# Fight summaries are never expired.
# RETENTION_DAYS=90

DEFAULT_GUILD_ID=infamous
SNAPSHOT_INTERVAL_MS=1000
MAX_SESSIONS=200

INGEST_BATCH_RATE=20
INGEST_BATCH_BURST=200

PULL_IDLE_TIMEOUT_MS=8000
PULL_EXIT_GRACE_MS=2500

# --- Discord sign-in -------------------------------------------------------
# Sign-in stays disabled until SESSION_SECRET and all three DISCORD_* values
# are present, so the rest of the API works without configuring OAuth.
# SESSION_SECRET must be at least 32 characters; it signs session cookies and
# the OAuth state parameter.
# SESSION_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_GUILD_ID=

# Comma-separated Discord role ids. Moderator never defaults on: leave it empty
# and nobody gets moderator. Leave member empty and everyone in the guild is a
# member.
DISCORD_MODERATOR_ROLE_IDS=
DISCORD_MEMBER_ROLE_IDS=

# Public origin of this API; the OAuth redirect is derived from it.
PUBLIC_API_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# Set true in production so session cookies are only sent over HTTPS.
COOKIE_SECURE=false
